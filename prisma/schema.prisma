generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Practice {
  id                        String                     @id @default(cuid())
  clerkOrgId                String                     @unique
  name                      String
  timeZone                  String                     @default("Africa/Johannesburg")
  patients                  Patient[]
  staff                     Staff[]
  appointments              Appointment[]
  practitionerSchedules     PractitionerSchedule[]
  encounters                Encounter[]
  invoices                  Invoice[]
  payments                  Payment[]
  claims                    Claim[]
  documents                 PatientDocument[]
  portalMessages            PortalMessage[]
  auditLogs                 AuditLog[]
  patientConsents           PatientConsent[]
  patientPurposeConsents    PatientPurposeConsent[]
  patientCorrectionRequests PatientCorrectionRequest[]
  breakGlassRequests        BreakGlassRequest[]
  drugCatalog               DrugCatalog[]
  pharmacies                Pharmacy[]
  telehealthSessions        TelehealthSession[]
  scribeSessions            ScribeSession[]
  codingSuggestions         CodingSuggestion[]
}

model Staff {
  id                         String                 @id @default(cuid())
  clerkId                    String                 @unique
  practiceId                 String
  email                      String
  firstName                  String
  lastName                   String
  role                       StaffRole
  isActive                   Boolean                @default(true)
  practice                   Practice               @relation(fields: [practiceId], references: [id])
  appointments               Appointment[]
  schedules                  PractitionerSchedule[]
  encounters                 Encounter[]
  prescriptions              Prescription[]
  observations               Observation[]
  patientMedicalAids         PatientMedicalAid[]
  patientConditions          PatientCondition[]
  patientAllergies           PatientAllergy[]
  medicationStatements       MedicationStatement[]
  immunizations              Immunization[]
  familyHistory              FamilyHistory[]
  labResults                 LabResult[]
  vitalSigns                 VitalSign[]
  invoices                   Invoice[]
  payments                   Payment[]
  claims                     Claim[]
  documents                  PatientDocument[]
  sentMessages               PortalMessage[]        @relation("PortalMessageStaffSender")
  breakGlassRequests         BreakGlassRequest[]    @relation("BreakGlassRequester")
  reviewedBreakGlassRequests BreakGlassRequest[]    @relation("BreakGlassReviewer")
  encounterAddenda           EncounterAddendum[]
  telehealthSessions         TelehealthSession[]
  scribeSessions             ScribeSession[]
  codingSuggestions          CodingSuggestion[]
}

model Patient {
  id                           String                     @id @default(cuid())
  clerkId                      String?                    @unique
  clerkInvitationId            String?                    @unique
  practiceId                   String
  email                        String
  firstName                    String
  lastName                     String
  preferredName                String?
  dateOfBirth                  DateTime?                  @db.Date
  sexAtBirth                   PatientSexAtBirth?
  genderIdentity               String?
  phone                        String?
  smsRemindersEnabled          Boolean                    @default(false)
  alternatePhone               String?
  addressLine1                 String?
  addressLine2                 String?
  suburb                       String?
  city                         String?
  province                     String?
  postalCode                   String?
  country                      String?
  preferredLanguage            String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  practice                     Practice                   @relation(fields: [practiceId], references: [id])
  appointments                 Appointment[]
  encounters                   Encounter[]
  prescriptions                Prescription[]
  observations                 Observation[]
  medicalAids                  PatientMedicalAid[]
  conditions                   PatientCondition[]
  allergies                    PatientAllergy[]
  medicationHistory            MedicationStatement[]
  immunizations                Immunization[]
  familyHistory                FamilyHistory[]
  labResults                   LabResult[]
  vitalSigns                   VitalSign[]
  invoices                     Invoice[]
  payments                     Payment[]
  claims                       Claim[]
  documents                    PatientDocument[]
  messages                     PortalMessage[]            @relation("PortalMessagePatientSubject")
  sentMessages                 PortalMessage[]            @relation("PortalMessagePatientSender")
  consents                     PatientConsent[]
  purposeConsents              PatientPurposeConsent[]
  correctionRequests           PatientCorrectionRequest[]
  breakGlassRequests           BreakGlassRequest[]
  telehealthSessions           TelehealthSession[]
  scribeSessions               ScribeSession[]
  codingSuggestions            CodingSuggestion[]
}

model Appointment {
  id              String            @id @default(cuid())
  practiceId      String
  patientId       String
  practitionerId  String?
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(BOOKED)
  kind            AppointmentKind   @default(IN_PERSON)
  reason          String?
  createdAt       DateTime          @default(now())

  practice          Practice              @relation(fields: [practiceId], references: [id])
  patient           Patient               @relation(fields: [patientId], references: [id])
  practitioner      Staff?                @relation(fields: [practitionerId], references: [id])
  reminders         AppointmentReminder[]
  telehealthSession TelehealthSession?

  @@index([practiceId, scheduledAt])
  @@index([practitionerId, scheduledAt])
}

model PractitionerSchedule {
  id                  String   @id @default(cuid())
  practiceId          String
  practitionerId      String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  practice     Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  practitioner Staff    @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, dayOfWeek])
  @@index([practiceId, practitionerId, dayOfWeek])
}

model AppointmentReminder {
  id            String                    @id @default(cuid())
  appointmentId String
  kind          AppointmentReminderKind
  scheduledFor  DateTime
  status        AppointmentReminderStatus @default(PENDING)
  attempts      Int                       @default(0)
  nextAttemptAt DateTime?
  processingAt  DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([status, scheduledFor])
  @@index([status, nextAttemptAt])
}

model Encounter {
  id             String               @id @default(cuid())
  practiceId     String
  patientId      String
  practitionerId String
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  status         EncounterStatus      @default(IN_PROGRESS)
  chiefComplaint String?
  diagnosis      String?
  notes          String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  sensitivity    EncounterSensitivity @default(NORMAL)
  signedAt       DateTime?
  lockedHash     String?

  practice             Practice              @relation(fields: [practiceId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id])
  practitioner         Staff                 @relation(fields: [practitionerId], references: [id])
  prescriptions        Prescription[]
  observations         Observation[]
  conditions           PatientCondition[]
  allergies            PatientAllergy[]
  medicationStatements MedicationStatement[]
  immunizations        Immunization[]
  familyHistory        FamilyHistory[]
  labResults           LabResult[]
  vitalSigns           VitalSign[]
  invoices             Invoice[]
  claims               Claim[]
  addenda              EncounterAddendum[]
  scribeSessions       ScribeSession[]
}

model EncounterAddendum {
  id          String               @id @default(cuid())
  encounterId String
  authorId    String
  text        String
  sensitivity EncounterSensitivity @default(NORMAL)
  createdAt   DateTime             @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  author    Staff     @relation(fields: [authorId], references: [id])

  @@index([encounterId, createdAt])
}

model Prescription {
  id                  String                @id @default(cuid())
  encounterId         String
  patientId           String
  practitionerId      String
  medication          String
  dosage              String
  route               String?
  frequency           String?
  duration            String?
  quantity            String?
  refills             Int                   @default(0)
  instructions        String?
  drugCatalogId       String?
  signedAt            DateTime?
  signedHash          String?
  pdfHash             String?
  pharmacyId          String?
  pharmacyStatus      PharmacyHandoffStatus @default(NOT_SENT)
  sentAt              DateTime?
  pharmacyReference   String?
  interactionWarnings Json                  @default("[]")
  status              PrescriptionStatus    @default(ACTIVE)
  createdAt           DateTime              @default(now())

  encounter            Encounter             @relation(fields: [encounterId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id])
  practitioner         Staff                 @relation(fields: [practitionerId], references: [id])
  drugCatalog          DrugCatalog?          @relation(fields: [drugCatalogId], references: [id])
  pharmacy             Pharmacy?             @relation(fields: [pharmacyId], references: [id])
  medicationStatements MedicationStatement[]
}

model DrugCatalog {
  id                String   @id @default(cuid())
  practiceId        String
  name              String
  genericName       String?
  strength          String?
  form              String?
  route             String?
  activeIngredients String?
  externalCode      String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  practice        Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  prescriptions   Prescription[]
  interactionsAsA DrugInteraction[] @relation("DrugInteractionA")
  interactionsAsB DrugInteraction[] @relation("DrugInteractionB")

  @@unique([practiceId, name, strength])
  @@index([practiceId, isActive, name])
}

model DrugInteraction {
  id          String              @id @default(cuid())
  drugAId     String
  drugBId     String
  severity    InteractionSeverity
  description String
  source      String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())

  drugA DrugCatalog @relation("DrugInteractionA", fields: [drugAId], references: [id], onDelete: Cascade)
  drugB DrugCatalog @relation("DrugInteractionB", fields: [drugBId], references: [id], onDelete: Cascade)

  @@unique([drugAId, drugBId])
  @@index([drugAId, isActive])
  @@index([drugBId, isActive])
}

model Pharmacy {
  id         String   @id @default(cuid())
  practiceId String
  name       String
  phone      String?
  email      String?
  address    String?
  externalId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  practice      Practice       @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

  @@index([practiceId, isActive, name])
}

model Observation {
  id           String          @id @default(cuid())
  encounterId  String?
  patientId    String
  recordedById String
  type         ObservationType
  name         String
  value        String
  unit         String?
  recordedAt   DateTime        @default(now())

  encounter  Encounter? @relation(fields: [encounterId], references: [id])
  patient    Patient    @relation(fields: [patientId], references: [id])
  recordedBy Staff      @relation(fields: [recordedById], references: [id])

  @@index([patientId, type, name, recordedAt])
}

model PatientMedicalAid {
  id                      String    @id @default(cuid())
  patientId               String
  recordedById            String?
  schemeName              String
  schemeCode              String?
  planName                String?
  membershipNumber        String
  dependantCode           String?
  principalMemberName     String?
  relationshipToPrincipal String?
  preAuthorizationNumber  String?
  validFrom               DateTime? @db.Date
  validThrough            DateTime? @db.Date
  isPrimary               Boolean   @default(false)
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy Staff?  @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([patientId], map: "PatientMedicalAid_one_primary_per_patient", where: raw("\"isPrimary\" = true"))
  @@index([patientId, isPrimary])
  @@index([patientId, validThrough])
}

model PatientCondition {
  id           String                 @id @default(cuid())
  patientId    String
  encounterId  String?
  recordedById String?
  codeSystem   String?
  code         String?
  name         String
  status       PatientConditionStatus @default(ACTIVE)
  onsetDate    DateTime?              @db.Date
  resolvedDate DateTime?              @db.Date
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy Staff?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@index([patientId, onsetDate])
  @@index([codeSystem, code])
}

model PatientAllergy {
  id           String          @id @default(cuid())
  patientId    String
  encounterId  String?
  recordedById String?
  substance    String
  reaction     String?
  severity     AllergySeverity @default(UNKNOWN)
  status       AllergyStatus   @default(ACTIVE)
  onsetDate    DateTime?       @db.Date
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy Staff?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@index([patientId, substance])
}

model MedicationStatement {
  id             String           @id @default(cuid())
  patientId      String
  encounterId    String?
  prescriptionId String?
  recordedById   String?
  medication     String
  strength       String?
  dosage         String?
  route          String?
  frequency      String?
  instructions   String?
  status         MedicationStatus @default(ACTIVE)
  source         String?
  startedAt      DateTime?        @db.Date
  endedAt        DateTime?        @db.Date
  notes          String?
  recordedAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter    Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  recordedBy   Staff?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@index([patientId, startedAt])
  @@index([prescriptionId])
}

model Immunization {
  id               String             @id @default(cuid())
  patientId        String
  encounterId      String?
  administeredById String?
  vaccine          String
  productName      String?
  manufacturer     String?
  lotNumber        String?
  doseNumber       String?
  route            String?
  site             String?
  status           ImmunizationStatus @default(COMPLETED)
  administeredAt   DateTime?
  nextDueAt        DateTime?          @db.Date
  notes            String?
  createdAt        DateTime           @default(now())

  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter      Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  administeredBy Staff?     @relation(fields: [administeredById], references: [id], onDelete: SetNull)

  @@index([patientId, administeredAt])
  @@index([patientId, nextDueAt])
  @@index([encounterId])
}

model FamilyHistory {
  id           String   @id @default(cuid())
  patientId    String
  encounterId  String?
  recordedById String?
  relationship String
  condition    String
  codeSystem   String?
  code         String?
  ageAtOnset   Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy Staff?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, relationship])
  @@index([patientId, condition])
}

model LabResult {
  id             String          @id @default(cuid())
  patientId      String
  encounterId    String?
  recordedById   String?
  testName       String
  codeSystem     String?
  code           String?
  resultValue    String
  numericValue   Decimal?        @db.Decimal(12, 4)
  unit           String?
  referenceRange String?
  interpretation String?
  status         LabResultStatus @default(FINAL)
  collectedAt    DateTime?
  resultAt       DateTime        @default(now())
  releasedAt     DateTime?
  notes          String?

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy Staff?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, resultAt])
  @@index([patientId, testName, resultAt])
  @@index([codeSystem, code])
}

model VitalSign {
  id           String        @id @default(cuid())
  patientId    String
  encounterId  String?
  recordedById String?
  kind         VitalSignKind
  value        Decimal?      @db.Decimal(12, 4)
  systolic     Decimal?      @db.Decimal(12, 4)
  diastolic    Decimal?      @db.Decimal(12, 4)
  unit         String?
  measuredAt   DateTime      @default(now())
  method       String?
  bodySite     String?
  notes        String?

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy Staff?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([patientId, kind, measuredAt])
  @@index([encounterId])
}

model Invoice {
  id           String        @id @default(cuid())
  practiceId   String
  patientId    String
  encounterId  String?
  createdById  String
  amount       Decimal
  patientShare Decimal       @default(0) @db.Decimal(12, 2)
  schemeShare  Decimal       @default(0) @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  dueDate      DateTime?
  createdAt    DateTime      @default(now())

  practice  Practice      @relation(fields: [practiceId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])
  encounter Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy Staff         @relation(fields: [createdById], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]
  claims    Claim[]

  @@index([encounterId])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  tariffCode    String
  icd10Code     String?
  description   String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  modifierCodes String[] @default([])

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Claim {
  id                String      @id @default(cuid())
  practiceId        String
  patientId         String
  encounterId       String?
  invoiceId         String?
  submittedById     String
  payer             String
  schemeCode        String?
  memberNumber      String?
  dependantCode     String?
  claimNumber       String?
  amount            Decimal
  amountAuthorised  Decimal?    @db.Decimal(12, 2)
  amountPaid        Decimal?    @db.Decimal(12, 2)
  status            ClaimStatus @default(DRAFT)
  rejectReason      String?
  switchingRef      String?
  rawRequest        Json?
  rawResponse       Json?
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  responseAt        DateTime?
  adjudicatedAt     DateTime?
  resubmissionCount Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  practice    Practice     @relation(fields: [practiceId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  encounter   Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  submittedBy Staff        @relation(fields: [submittedById], references: [id])
  events      ClaimEvent[]

  @@index([practiceId, status])
  @@index([patientId])
  @@index([encounterId])
  @@index([switchingRef])
}

model ClaimEvent {
  id          String   @id @default(cuid())
  claimId     String
  type        String
  description String
  payload     Json?
  createdAt   DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
}

model Payment {
  id           String           @id @default(cuid())
  practiceId   String
  patientId    String
  invoiceId    String
  recordedById String
  amount       Decimal
  method       PaymentMethod
  payerType    PaymentPayerType @default(PATIENT)
  reference    String?
  recordedAt   DateTime         @default(now())

  practice   Practice @relation(fields: [practiceId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id])
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy Staff    @relation(fields: [recordedById], references: [id])
}

model PatientDocument {
  id           String   @id @default(cuid())
  practiceId   String
  patientId    String
  uploadedById String
  name         String
  fileUrl      String
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  practice   Practice @relation(fields: [practiceId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy Staff    @relation(fields: [uploadedById], references: [id])
}

model PortalMessage {
  id              String              @id @default(cuid())
  practiceId      String
  patientId       String
  senderType      PortalMessageSender
  senderStaffId   String?
  senderPatientId String?
  body            String
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  practice      Practice @relation(fields: [practiceId], references: [id])
  patient       Patient  @relation("PortalMessagePatientSubject", fields: [patientId], references: [id], onDelete: Cascade)
  senderStaff   Staff?   @relation("PortalMessageStaffSender", fields: [senderStaffId], references: [id])
  senderPatient Patient? @relation("PortalMessagePatientSender", fields: [senderPatientId], references: [id])
}

model AuditLog {
  id           String         @id @default(cuid())
  practiceId   String
  actorId      String
  actorType    AuditActorType
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  @@index([practiceId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}

enum StaffRole {
  PRACTICE_MANAGER
  PRACTITIONER
  RECEPTIONIST
  BILLING_CLERK
  NURSE
  ASSISTANT
  VIEWER
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentReminderKind {
  DAY_BEFORE
  TWO_HOURS_BEFORE
}

enum AppointmentReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EncounterSensitivity {
  NORMAL
  SENSITIVE
  RESTRICTED
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  SIGNED
  SENT
  COMPLETED
  CANCELLED
}

enum PharmacyHandoffStatus {
  NOT_SENT
  QUEUED
  SENT
  FAILED
  ACKNOWLEDGED
  CANCELLED
}

enum InteractionSeverity {
  MINOR
  MODERATE
  SEVERE
  CONTRAINDICATED
}

enum ObservationType {
  VITAL
  LAB
  NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  BANK_TRANSFER
  OTHER
  MEDICAL_AID
}

enum PaymentPayerType {
  PATIENT
  MEDICAL_AID
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  REJECTED
  RESUBMITTED
  PAID
  CLOSED
  WRITTEN_OFF
}

enum PortalMessageSender {
  PATIENT
  PRACTICE
}

enum AuditActorType {
  STAFF
  PATIENT
}

enum PatientConsentPurpose {
  AI_SCRIBE
  TELEHEALTH
  RECORDING
  MARKETING
  THIRD_PARTY_SHARE
}

enum AppointmentKind {
  IN_PERSON
  TELEHEALTH
}

enum TelehealthStatus {
  WAITING
  IN_PROGRESS
  ENDED
  CANCELLED
}

enum RecordingStatus {
  NOT_REQUESTED
  CONSENT_PENDING
  RECORDING
  STOPPED
  FAILED
}

enum ScribeStatus {
  DRAFT
  GENERATED
  REVIEWED
