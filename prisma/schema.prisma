model PatientConsent {
  id            String   @id @default(cuid())
  practiceId    String
  patientId     String
  noticeVersion String
  acceptedAt    DateTime @default(now())
  acceptedByIp  String?

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([practiceId, patientId, noticeVersion])
  @@index([patientId, acceptedAt])
}

model PatientPurposeConsent {
  id           String                @id @default(cuid())
  practiceId   String
  patientId    String
  purpose      PatientConsentPurpose
  granted      Boolean
  scopeText    String                @db.Text
  scopeVersion String
  actorType    AuditActorType
  sequence     Int                   @unique @default(autoincrement())
  recordedAt   DateTime              @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([practiceId, patientId, purpose, recordedAt])
}

model TelehealthSession {
  id                 String           @id @default(cuid())
  practiceId         String
  appointmentId      String           @unique
  patientId          String
  practitionerId     String
  status             TelehealthStatus @default(WAITING)
  patientConsentAt   DateTime?
  recordingStatus    RecordingStatus  @default(NOT_REQUESTED)
  recordingConsentAt DateTime?
  recordingStartedAt DateTime?
  recordingEndedAt   DateTime?
  recordingUrl       String?
  startedAt          DateTime         @default(now())
  endedAt            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  practice     Practice           @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  appointment  Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Staff              @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  signals      TelehealthSignal[]

  @@index([practiceId, status])
}

model TelehealthSignal {
  id        String   @id @default(cuid())
  sessionId String
  senderId  String
  targetId  String
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  session TelehealthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, targetId, createdAt])
}

model ScribeSession {
  id              String       @id @default(cuid())
  practiceId      String
  patientId       String
  practitionerId  String
  encounterId     String?
  status          ScribeStatus @default(DRAFT)
  transcript      String       @db.Text
  draftSubjective String?      @db.Text
  draftObjective  String?      @db.Text
  draftAssessment String?      @db.Text
  draftPlan       String?      @db.Text
  draftDiagnosis  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  practice          Practice           @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner      Staff              @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  encounter         Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  codingSuggestions CodingSuggestion[]

  @@index([practiceId, patientId, practitionerId, createdAt])
}

model CodingSuggestion {
  id              String    @id @default(cuid())
  practiceId      String
  patientId       String
  practitionerId  String
  scribeSessionId String?
  system          String
  code            String
  description     String
  rationale       String?
  confidence      Int       @default(0)
  accepted        Boolean?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  practice      Practice       @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner  Staff          @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  scribeSession ScribeSession? @relation(fields: [scribeSessionId], references: [id], onDelete: Cascade)

  @@index([practiceId, patientId, scribeSessionId])
}

model PatientCorrectionRequest {
  id               String                         @id @default(cuid())
  practiceId       String
  patientId        String
  requestedFields  String
  requestedChanges String
  status           PatientCorrectionRequestStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime                       @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([practiceId, status, createdAt])
  @@index([patientId, createdAt])
}

model BreakGlassRequest {
  id               String           @id @default(cuid())
  practiceId       String
  patientId        String
  requesterStaffId String
  reviewerStaffId  String?
  reason           String
  status           BreakGlassStatus @default(PENDING)
  expiresAt        DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  practice  Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requester Staff    @relation("BreakGlassRequester", fields: [requesterStaffId], references: [id], onDelete: Cascade)
  reviewer  Staff?   @relation("BreakGlassReviewer", fields: [reviewerStaffId], references: [id], onDelete: SetNull)

  @@index([practiceId, status, createdAt])
  @@index([requesterStaffId, patientId, status])
}

enum BreakGlassStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}
