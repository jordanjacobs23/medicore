generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Practice {
  id                 String              @id @default(cuid())
  clerkOrgId         String              @unique
  name               String
  patients           Patient[]
  staff              Staff[]
  appointments       Appointment[]
  encounters         Encounter[]
  invoices           Invoice[]
  payments           Payment[]
  claims             Claim[]
  documents          PatientDocument[]
  portalMessages     PortalMessage[]
  auditLogs          AuditLog[]
  patientConsents    PatientConsent[]
  breakGlassRequests BreakGlassRequest[]
}

model Staff {
  id                         String              @id @default(cuid())
  clerkId                    String              @unique
  practiceId                 String
  email                      String
  firstName                  String
  lastName                   String
  role                       StaffRole
  isActive                   Boolean             @default(true)
  practice                   Practice            @relation(fields: [practiceId], references: [id])
  appointments               Appointment[]
  encounters                 Encounter[]
  prescriptions              Prescription[]
  observations               Observation[]
  invoices                   Invoice[]
  payments                   Payment[]
  claims                     Claim[]
  documents                  PatientDocument[]
  sentMessages               PortalMessage[]     @relation("PortalMessageStaffSender")
  breakGlassRequests         BreakGlassRequest[] @relation("BreakGlassRequester")
  reviewedBreakGlassRequests BreakGlassRequest[] @relation("BreakGlassReviewer")
}

model Patient {
  id                 String              @id @default(cuid())
  clerkId            String              @unique
  practiceId         String
  email              String
  firstName          String
  lastName           String
  practice           Practice            @relation(fields: [practiceId], references: [id])
  appointments       Appointment[]
  encounters         Encounter[]
  prescriptions      Prescription[]
  observations       Observation[]
  invoices           Invoice[]
  payments           Payment[]
  claims             Claim[]
  documents          PatientDocument[]
  messages           PortalMessage[]     @relation("PortalMessagePatientSubject")
  sentMessages       PortalMessage[]     @relation("PortalMessagePatientSender")
  consents           PatientConsent[]
  breakGlassRequests BreakGlassRequest[]
}

model Appointment {
  id             String            @id @default(cuid())
  practiceId     String
  patientId      String
  practitionerId String?
  scheduledAt    DateTime
  status         AppointmentStatus @default(BOOKED)
  reason         String?
  createdAt      DateTime          @default(now())

  practice     Practice @relation(fields: [practiceId], references: [id])
  patient      Patient  @relation(fields: [patientId], references: [id])
  practitioner Staff?   @relation(fields: [practitionerId], references: [id])
}

model Encounter {
  id             String          @id @default(cuid())
  practiceId     String
  patientId      String
  practitionerId String
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  status         EncounterStatus @default(IN_PROGRESS)
  chiefComplaint String?
  diagnosis      String?
  notes          String?

  practice      Practice       @relation(fields: [practiceId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  practitioner  Staff          @relation(fields: [practitionerId], references: [id])
  prescriptions Prescription[]
  observations  Observation[]
}

model Prescription {
  id             String             @id @default(cuid())
  encounterId    String
  patientId      String
  practitionerId String
  medication     String
  dosage         String
  instructions   String?
  status         PrescriptionStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())

  encounter    Encounter @relation(fields: [encounterId], references: [id])
  patient      Patient   @relation(fields: [patientId], references: [id])
  practitioner Staff     @relation(fields: [practitionerId], references: [id])
}

model Observation {
  id           String          @id @default(cuid())
  encounterId  String?
  patientId    String
  recordedById String
  type         ObservationType
  name         String
  value        String
  unit         String?
  recordedAt   DateTime        @default(now())

  encounter  Encounter? @relation(fields: [encounterId], references: [id])
  patient    Patient    @relation(fields: [patientId], references: [id])
  recordedBy Staff      @relation(fields: [recordedById], references: [id])
}

model Invoice {
  id          String        @id @default(cuid())
  practiceId  String
  patientId   String
  createdById String
  amount      Decimal
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  practice  Practice  @relation(fields: [practiceId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  createdBy Staff     @relation(fields: [createdById], references: [id])
  payments  Payment[]
  claims    Claim[]
}

model Claim {
  id            String      @id @default(cuid())
  practiceId    String
  patientId     String
  invoiceId     String?
  submittedById String
  payer         String
  claimNumber   String?
  amount        Decimal
  status        ClaimStatus @default(DRAFT)
  submittedAt   DateTime?
  adjudicatedAt DateTime?
  createdAt     DateTime    @default(now())

  practice    Practice @relation(fields: [practiceId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  submittedBy Staff    @relation(fields: [submittedById], references: [id])
}

model Payment {
  id           String        @id @default(cuid())
  practiceId   String
  patientId    String
  invoiceId    String
  recordedById String
  amount       Decimal
  method       PaymentMethod
  reference    String?
  recordedAt   DateTime      @default(now())

  practice   Practice @relation(fields: [practiceId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id])
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy Staff    @relation(fields: [recordedById], references: [id])
}

model PatientDocument {
  id           String   @id @default(cuid())
  practiceId   String
  patientId    String
  uploadedById String
  name         String
  fileUrl      String
  contentType  String
  size         Int
  createdAt    DateTime @default(now())

  practice   Practice @relation(fields: [practiceId], references: [id])
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy Staff    @relation(fields: [uploadedById], references: [id])
}

model PortalMessage {
  id              String              @id @default(cuid())
  practiceId      String
  patientId       String
  senderType      PortalMessageSender
  senderStaffId   String?
  senderPatientId String?
  body            String
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  practice      Practice @relation(fields: [practiceId], references: [id])
  patient       Patient  @relation("PortalMessagePatientSubject", fields: [patientId], references: [id], onDelete: Cascade)
  senderStaff   Staff?   @relation("PortalMessageStaffSender", fields: [senderStaffId], references: [id])
  senderPatient Patient? @relation("PortalMessagePatientSender", fields: [senderPatientId], references: [id])
}

model AuditLog {
  id           String         @id @default(cuid())
  practiceId   String
  actorId      String
  actorType    AuditActorType
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  @@index([practiceId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}

enum StaffRole {
  PRACTICE_MANAGER
  PRACTITIONER
  RECEPTIONIST
  BILLING_CLERK
  NURSE
  ASSISTANT
  VIEWER
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ObservationType {
  VITAL
  LAB
  NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  BANK_TRANSFER
  OTHER
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  DENIED
  PAID
  CLOSED
}

enum PortalMessageSender {
  PATIENT
  PRACTICE
}

enum AuditActorType {
  STAFF
  PATIENT
}

model PatientConsent {
  id            String   @id @default(cuid())
  practiceId    String
  patientId     String
  noticeVersion String
  acceptedAt    DateTime @default(now())
  acceptedByIp  String?

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([practiceId, patientId, noticeVersion])
  @@index([patientId, acceptedAt])
}

model BreakGlassRequest {
  id               String           @id @default(cuid())
  practiceId       String
  patientId        String
  requesterStaffId String
  reviewerStaffId  String?
  reason           String
  status           BreakGlassStatus @default(PENDING)
  expiresAt        DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  practice  Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requester Staff    @relation("BreakGlassRequester", fields: [requesterStaffId], references: [id], onDelete: Cascade)
  reviewer  Staff?   @relation("BreakGlassReviewer", fields: [reviewerStaffId], references: [id], onDelete: SetNull)

  @@index([practiceId, status, createdAt])
  @@index([requesterStaffId, patientId, status])
}

enum BreakGlassStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}
